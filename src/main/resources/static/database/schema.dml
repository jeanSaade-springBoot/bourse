INSERT INTO `bourse`.`asset_news_order`
(`id`,
`asset_code`,
`asset_name`,
`order_id`,`asset_id`)
select  1 , a.asset_code, a.description,1 as order_id ,a.id from asset_class a where a.id=1;
INSERT INTO `bourse`.`asset_news_order`
(`id`,
`asset_code`,
`asset_name`,
`order_id`,`asset_id`)
select  2 , a.asset_code, a.description,2 as order_id ,a.id from asset_class a where a.id=2;
update asset_news_order_sequence
set next_val = (select max(id)+1 from asset_news_order);


ALTER TABLE function_asset
ADD COLUMN group_id INT NULL,
ADD COLUMN subgroup_id INT NULL;

ALTER TABLE function_asset
ADD INDEX idx_function_asset_group_subgroup (
    asset_class_id,
    function_id,
    group_id,
    subgroup_id
);

INSERT INTO function_asset
(
    id,
    is_hidden,
    asset_class_id,
    function_id,
    group_id,
    subgroup_id
)
SELECT
    @row_number := @row_number + 1 AS id,
    false,
    2,
    f.id,
    6,
    sg.subgroup_id
FROM functions f
CROSS JOIN (
    SELECT 1 AS subgroup_id
    UNION ALL
    SELECT 2
) sg
CROSS JOIN (
    SELECT @row_number := (
        SELECT COALESCE(MAX(id),0)
        FROM function_asset
    )
) t
WHERE NOT EXISTS (
    -- function missing from asset 2 entirely
    SELECT 1
    FROM function_asset fa
    WHERE fa.function_id = f.id
      AND fa.asset_class_id = 2
)
AND NOT EXISTS (
    -- prevent duplicate insert for group 6 subgroup 1/2
    SELECT 1
    FROM function_asset fa
    WHERE fa.asset_class_id = 2
      AND fa.function_id = f.id
      AND fa.group_id = 6
      AND fa.subgroup_id = sg.subgroup_id
);

update function_asset set is_hidden = true where function_id between  16 and 36 and asset_class_id=2;
  
UPDATE robots_configuration rc
JOIN column_configuration cc
    ON rc.config_id = cc.id
SET rc.column_description = cc.description
WHERE rc.group_id = 6
AND cc.group_id = 6;

UPDATE robots_function_configuration rc
JOIN column_configuration cc
    ON rc.config_id = cc.id
SET rc.column_description = cc.description
WHERE rc.group_id = 6
AND cc.group_id = 6;

 
 

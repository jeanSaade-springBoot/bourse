		 WHEN s.id_sub_group=3 THEN 'euribor3'
		 WHEN s.id_sub_group=4 THEN 'euribor4'
		 WHEN s.id_sub_group=5 THEN 'euribor5'
		ELSE 'euribor1_euribor2_euribor3_euribor4_euribor5' END ,

SET @nextId = (SELECT MAX(id) FROM energy_data);

INSERT INTO energy_data (id, refer_date, subgroup_id, value)
SELECT
    (@nextId := @nextId + 1),
    refer_date,
    8,
    ''
FROM (
    SELECT DISTINCT refer_date
    FROM energy_data
) d
WHERE NOT EXISTS (
    SELECT 1
    FROM energy_data e
    WHERE e.refer_date = d.refer_date
      AND e.subgroup_id = 8
);

UPDATE energy_data_sequence
SET next_val = (
    SELECT MAX(id) + 1
    FROM energy_data
);


create table tmp_audit_us_jobsopenings (id bigint not null, 
	 `final` varchar(255), 
     `initial` varchar(255), 
     `surv` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_us_jobsopenings_sequence (next_val bigint) ;
insert into audit_us_jobsopenings_sequence values ( 1 );


create table tmp_audit_us_adpchange (id bigint not null, 
	 `final` varchar(255), 
     `initial` varchar(255), 
     `surv` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_us_adpchange_sequence (next_val bigint) ;
insert into audit_us_adpchange_sequence values ( 1 );


create table tmp_audit_us_nfpayrolls(id bigint not null, 
	 `final` varchar(255), 
	 `rev1` varchar(255), 
     `initial` varchar(255), 
     `surv` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_us_nfpayrolls_sequence (next_val bigint) ;
insert into audit_us_nfpayrolls_sequence values ( 1 );


create table tmp_audit_us_unemprate(id bigint not null, 
	 `index` varchar(255), 
     `surv` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_us_unemprate_sequence (next_val bigint) ;
insert into audit_us_unemprate_sequence values ( 1 );


create table tmp_audit_us_householdsurv(id bigint not null, 
	 `civilian_lab_force` varchar(255), 
     `civilian_lab_force_chg` varchar(255), 
      `employed_lab_force` varchar(255), 
     `employed_lab_force_chg` varchar(255), 
      `unemployed` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_us_householdsurv_sequence (next_val bigint) ;
insert into audit_us_householdsurv_sequence values ( 1 );



INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	12 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'final'
        WHEN 2 THEN 'initial'
        WHEN 3 THEN 'surv'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 77 THEN 'tmp_audit_us_jobsopenings'
          WHEN 78 THEN 'tmp_audit_us_adpchange' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(77,78) ;



INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	12 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'final'
		WHEN 2 THEN 'rev1'
        WHEN 3 THEN 'initial'
        WHEN 4 THEN 'surv'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 79 THEN 'tmp_audit_us_nfpayrolls' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(79) ;

INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	12 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'index'
        WHEN 2 THEN 'surv'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 80 THEN 'tmp_audit_us_unemprate' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(80) ;


INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	12 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'civilian_lab_force'
        WHEN 2 THEN 'civilian_lab_force_chg'
		WHEN 3 THEN 'employed_lab_force'
        WHEN 4 THEN 'employed_lab_force_chg'
        WHEN 5 THEN 'unemployed'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 81 THEN 'tmp_audit_us_householdsurv' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(81) ;



INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
         CONCAT(t.column_name, '-', s.group_Id) as `description`,
		 s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		0 as `factor`,
		s.description  as `descwitoutfactor`,
		s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, 
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in (77,78,79,80,81)
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id;
	  

 INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select 
		 @row_number:=@row_number + 1 as id ,
		'CALCULATED' as `calculation_type`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.display_description as `display_description`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.subgroup_id as`subgroup_id`,
		s.id  as`config_id`,
        f.id as `function_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 s.factor as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		null as `currency`,
		s.column_code as `column_code`
		 from  column_configuration s,
				functions f,
(SELECT @row_number:=(SELECT max(id) from function_configuration)) AS t where s.group_id in (77,78,79,80,81);



 INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	6 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'DP15'
        WHEN 2 THEN 'DP25'
        WHEN 3 THEN 'ATM'
        WHEN 4 THEN 'DC25'
        WHEN 5 THEN 'DC15'
        WHEN 6 THEN 'DP15_ATM'
        WHEN 7 THEN 'DP25_ATM'
        WHEN 8 THEN 'DC25_ATM'
        WHEN 9 THEN 'DC15_ATM'
        WHEN 10 THEN 'DP25_DC25'
		WHEN 11 THEN 'DP15_DC15'
    END AS column_name ,
	'tmp_audit_skews_bund_2_maturity' from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=25;
	 


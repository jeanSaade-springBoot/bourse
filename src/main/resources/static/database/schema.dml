UPDATE `bourse`.`column_configuration` SET `description` = 'CLOSE-GOLD', `descwitoutfactor` = 'CLOSE-GOLD', `column_name` = 'CLOSE-GOLD' WHERE (`id` = '87');
UPDATE `bourse`.`column_configuration` SET `description` = 'CLOSE-SILVER', `descwitoutfactor` = 'CLOSE-SILVER', `column_name` = 'CLOSE-SILVER' WHERE (`id` = '88');

UPDATE `bourse`.`subgroup` SET `description` = 'PLATINUM' WHERE (`id` = '23');

delete from table_management where group_id=6;
 
INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	     select
		@rownum:=@rownum + 1  as id ,
		2 as asset_id,
		s.group_id,
		s.id_sub_group,
		s.description as column_name,
		'tmp_audit_precious' from subgroup s,
(SELECT @rownum:=(select next_val from robot_initializer_sequence)) r where s.group_id=6;
     
     update table_management set  column_name = 'PLATINUM_GOLD' where column_name = 'PLATINUM _ GOLD SPREAD';
     update table_management set  column_name = 'GOLD_SILVER' where column_name = 'GOLD _ SILVER RATIO';
	 
INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
		select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		t.column_name as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id in(6)  and s.id_sub_group in(6,7,8,9,10,11) and s.group_id = t.group_id and s.id_sub_group = t.subgroup_id;

 INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select 
		 @row_number:=@row_number + 1 as id ,
		'CALCULATED' as `calculation_type`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.display_description as `display_description`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.subgroup_id as`subgroup_id`,
		s.id  as`config_id`,
        f.id as `function_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 s.factor as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		null as `currency`,
		s.column_code as `column_code`
		 from  column_configuration s,
				functions f,
(SELECT @row_number:=(SELECT max(id) from function_configuration)) AS t where s.group_id in(6) and s.subgroup_id in (6,7,8,9,10,11);

INSERT INTO `bourse`.`function_configuration`
(
    `id`,
    `calculation_type`,
    `data_format`,
    `description`,
    `display_description`,
    `group_id`,
    `start_date`,
    `subgroup_id`,
    `config_id`,
    `function_id`,
    `tick_value`,
    `chart_type`,
    `y_axis_format`,
    `factor`,
    `descwitoutfactor`,
    `column_name`,
    `data_min_increment`,
    `chart_color`,
    `chart_showgrid`,
    `chart_size`,
    `chart_transparency`,
    `chartshow_markes`,
    `exchange_link`,
    `show_in_database`,
    `show_in_news_graph`,
    `currency`,
    `column_code`
)
SELECT 
     @row_number:=@row_number + 1 AS id,
    'CALCULATED' AS `calculation_type`,
    '0.000%' AS `data_format`,
    s.description AS `description`,
    s.display_description AS `display_description`,
    s.group_Id AS `group_id`,
    '03-01-2000' AS `start_date`,
    s.subgroup_id AS `subgroup_id`,
    s.id AS `config_id`,
    f.id AS `function_id`,
    NULL AS `tick_value`,
    'Area' AS `chart_type`,
    '0.00%' AS `y_axis_format`,
    s.factor AS `factor`,
    s.description AS `descwitoutfactor`,
    s.description AS `column_name`,
    NULL AS `data_min_increment`,
    '#44546a' AS `chart_color`,
    'true' AS `chart_showgrid`,
    '12px' AS `chart_size`,
    1 AS `chart_transparency`,
    1 AS `chartshow_markes`,
    NULL AS `exchange_link`,
    FALSE AS `show_in_database`,
    FALSE AS `show_in_news_graph`,
    NULL AS `currency`,
    s.column_code AS `column_code`
FROM column_configuration s
CROSS JOIN functions f
CROSS JOIN (
    SELECT @row_number := (
        SELECT MAX(id)
        FROM function_configuration
    )
) t
WHERE s.group_id IN (6)
  AND s.subgroup_id IN (1,2)
  AND NOT EXISTS (
        SELECT 1
        FROM function_configuration fc
        WHERE fc.function_id = f.id
          AND fc.config_id = s.id
    );

UPDATE `bourse`.`function_configuration` SET `description` = 'CLOSE-GOLD' WHERE  description='GOLD' ;
UPDATE `bourse`.`function_configuration` SET `description` = 'CLOSE-SILVER' WHERE  description='SILVER' ;

UPDATE column_configuration cc
JOIN table_management tm
    ON cc.group_id = tm.group_id
   AND cc.subgroup_id = tm.subgroup_id
     and cc.group_id =  6
SET cc.description = tm.column_name;

UPDATE function_configuration cc
JOIN table_management tm
    ON cc.group_id = tm.group_id
   AND cc.subgroup_id = tm.subgroup_id
     and cc.group_id =  6
SET cc.description = tm.column_name;


INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	10 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'maturity_name'
        WHEN 2 THEN 'open'
        WHEN 3 THEN 'settle'
		WHEN 4 THEN 'close'
        WHEN 5 THEN 'high'
        WHEN 6 THEN 'low'
        WHEN 7 THEN 'future_expiry_date'
		WHEN 8 THEN 'issuer'
        WHEN 9 THEN 'coupon'
        WHEN 10 THEN 'ctd_maturity'
        WHEN 11 THEN 'price_at_issue'
		WHEN 12 THEN 'frequency'
        WHEN 13 THEN 'convergence_factor'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 52 THEN 'tmp_audit_lef_bunds'
          WHEN 53 THEN 'tmp_audit_lef_bobls'
          WHEN 54 THEN 'tmp_audit_lef_shatz' 
		  WHEN 55 THEN 'tmp_audit_lef_buxl'
          WHEN 56 THEN 'tmp_audit_lef_oat'
          WHEN 57 THEN 'tmp_audit_lef_btp' 
          WHEN 58 THEN 'tmp_audit_lef_gilts'
          WHEN 59 THEN 'tmp_audit_lef_tnotes'
          WHEN 60 THEN 'tmp_audit_lef_tbonds' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(52,53,54,55,56,57,58,59,60) ;


INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	10 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 2 THEN 'open'
        WHEN 3 THEN 'settle'
		WHEN 4 THEN 'close'
        WHEN 5 THEN 'high'
        WHEN 6 THEN 'low'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 61 THEN 'tmp_audit_lef_bunds_rolling'
          WHEN 62 THEN 'tmp_audit_lef_bobls_rolling'
          WHEN 63 THEN 'tmp_audit_lef_shatz_rolling' 
		  WHEN 64 THEN 'tmp_audit_lef_buxl_rolling'
          WHEN 65 THEN 'tmp_audit_lef_oat_rolling'
          WHEN 67 THEN 'tmp_audit_lef_btp_rolling' 
          WHEN 68 THEN 'tmp_audit_lef_gilts_rolling'
          WHEN 69 THEN 'tmp_audit_lef_tnotes_rolling'
          WHEN 70 THEN 'tmp_audit_lef_tbonds_rolling' end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(61,62,63,64,65,67,68,69,70) ;

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
           CONCAT(t.column_name, '-', s.group_Id) as `description`,
		 s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		0 as `factor`,
		s.description  as `descwitoutfactor`,
		s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, 
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in (52,53,54,55,56,57,58,59,60)  
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id;
	  

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,

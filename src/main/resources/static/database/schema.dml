create table corporate_yields_data (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id)) ;
create table corporate_yields_data_sequence (next_val bigint) ;
insert into corporate_yields_data_sequence values ( 1 );
create table tmp_audit_corporate_yields (id bigint not null, usatoaaa varchar(255), usbtobbb varchar(255), usctoccc varchar(255),eurozoneatoaaa varchar(255),eurozonebtobbb varchar(255),refer_date varchar(255), primary key (id));

create table tmp_audit_credit_spreads (id bigint not null, usatoaaa_usa varchar(255), usbtobbb_usatoaaa varchar(255), usctoccc_usbtobbb varchar(255), eurozoneatoaaa_germany varchar(255), eurozonebtobbb_eurozoneatoaaa  varchar(255),refer_date varchar(255), primary key (id));

create table tmp_audit_corporate_liquidity_premia (id bigint not null, avg_usatoaaa_usa  varchar(255), avg_usbtobbb_usatoaaa varchar(255), avg_usctoccc_usbtobbb varchar(255), avg_eurozoneatoaaa_germany varchar(255), avg_eurozonebtobbb_eurozoneatoaaa varchar(255),refer_date varchar(255), primary key (id));


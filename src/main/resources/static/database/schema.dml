	4,
	s.group_id,
	s.id_sub_group,
	CASE WHEN s.id_sub_group=1 THEN 'bobl1' 
		 WHEN s.id_sub_group=2 THEN 'bobl2'
		ELSE 'bobl1_bobl2' END ,
	'tmp_audit_bobl_options_volume' from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=18;
	 
	 

update news_order_sequence set next_val = (select max(id)+1 from news_order);	   

INSERT INTO `bourse`.`asset_news_order`
(`id`,
`asset_code`,
`asset_name`,
`order_id`,`asset_id`)
select  10 , a.asset_code, a.description, 9 as order_id ,a.id from asset_class a where a.id=10;




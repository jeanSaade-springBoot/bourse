INSERT INTO `bourse`.`groups_table` (`id`, `asset_id`, `description`, `group_code`) VALUES ('10', '2', 'TRANSPORTATION', 'TRA');

INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('40', 'BALTIC DRY INDEX', '10', '1', 'TRANSPORTATION', 'BAL');
INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('41', '40ft Container', '10', '2', 'TRANSPORTATION', 'CON');

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
		select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		1 as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id=10 ;

INSERT INTO `bourse`.`ongoing_process` (`id`, `process_name`, `status`, `must_be_trigger`, `asset_id`, `group_id`) VALUES ('11', 'PROCESS_WITHOUT_FUNCTION', false, false, '2', '10');
INSERT INTO `bourse`.`ongoing_process` (`id`, `process_name`, `status`, `must_be_trigger`, `asset_id`, `group_id`) VALUES ('12', 'PROCESS_WITH_FUNCTION', false, false, '2', '10');

create table transportation_data (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id)) ;

create table transportation_data_sequence (next_val bigint) ;
insert into transportation_data_sequence values ( 1 );

create table tmp_audit_transportation (id bigint not null, 
 BALTIC varchar(255), 
`CONTAINER` varchar(255), 
 refer_date varchar(255), primary key (id));
 

update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		description,
		'dyncamic_robots_highlow_mono' as robot_name,
		'PROCESS_WITHOUT_FUNCTION' as process_name,
		2 as asset_id,
		10 as group_id,
        null as function_id
 from column_configuration,   
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
 where  group_id =10;
 
update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

   

INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select  @row_number:=@row_number + 1 as id,
'CALCULATED',
c.`data_format`,
c.`description`,
concat(c.`description`,' ', fn.description),
c.`group_id`,
c.`start_date`,
c.`subgroup_id`,
c.`id`,
fn.`id`,
null as `tick_value`,
'Area',
'0.00%',
c.`factor`,
null as `descwitoutfactor`,
c.`column_name`,
null as `data_min_increment`,
c.`chart_color`,
c.`chart_showgrid`,
c.`chart_size`,
c.`chart_transparency`,
c.`chartshow_markes`,
'NONE',
c.`show_in_database`,
c.`show_in_news_graph`,
null as `currency`,
c.`column_code` from column_configuration c, functions fn,
(SELECT @row_number:=(select max(id)+1 from function_configuration)) AS t where c.group_id in(6,7);

 UPDATE function_configuration fc, column_configuration cc , functions fn
SET fc.display_description = concat(cc.`description`,' ', fn.description)
WHERE fc.config_id = cc.id and fc.function_id = fn.id and  fc.display_description is null;

INSERT INTO `bourse`.`groups_table` (`id`, `asset_id`, `description`, `group_code`) VALUES ('8', '2', 'FOODSTUFF', 'FOD');

INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('30', 'CORN', '8', '1', 'FOODSTUFF', 'COR');
INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('31', 'SUGAR', '8', '2', 'FOODSTUFF', 'SUG');
INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('32', 'WHEAT', '8', '3', 'FOODSTUFF', 'WHE');

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
		select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		true as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id=8 ;


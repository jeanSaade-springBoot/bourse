update news_order_sequence set next_val = (select max(id)+1 from news_order);	  



INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
2,
s.group_id,
s.id_sub_group,
'BRENT_OIL' as description,
'tmp_audit_energy' from subgroup s,
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r where s.group_id=9 and s.id_sub_group=8;
 
 

 
INSERT INTO `bourse`.`groups_table` (`id`, `asset_id`, `description`, `group_code`) VALUES ('83', '3', 'FED LIQUIDITY', 'FEL');
INSERT INTO `bourse`.`groups_table` (`id`, `asset_id`, `description`, `group_code`) VALUES ('84', '3', 'ECB Balance Sheet', 'EBS');


INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('583', 'FED LIQUIDITY', '83', '1', 'FED LIQUIDITY', 'FED');
INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) VALUES ('584', 'ECB Balance Sheet', '84', '1', 'ECB Balance Sheet', 'ECD');


create table fed_liquidity_sequence (next_val bigint);
insert into fed_liquidity_sequence values ( 1 );

create table fed_liquidity (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id));

create table ecb_balance_sheet_liquidity_sequence (next_val bigint);
insert into ecb_balance_sheet_liquidity_sequence values ( 1 );

create table ecb_balance_sheet_liquidity (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id));

 
create table audit_fed_liquidity_sequence (next_val bigint);
insert into audit_fed_liquidity_sequence values ( 1 );

create table tmp_audit_fed_liquidity (id bigint not null, refer_date varchar(255), fed_liquidity varchar(255), primary key (id));

create table audit_ecb_balance_sheet_sequence (next_val bigint);
insert into audit_ecb_balance_sheet_sequence values ( 1 );

create table tmp_audit_ecb_balance_sheet_liquidity (id bigint not null, ecb_balance_sheet varchar(255), refer_date varchar(255), primary key (id)) ;


 INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
3,
s.group_id,
s.id_sub_group,
CASE WHEN s.id_sub_group=1 THEN 'fed_liquidity'  END ,
'tmp_audit_fed_liquidity' from subgroup s,
 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=83;
 
 
 INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
3,
s.group_id,
s.id_sub_group,
CASE WHEN s.id_sub_group=1 THEN 'ecb_balance_sheet'  END ,
'tmp_audit_ecb_balance_sheet_liquidity' from subgroup s,
 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=84;
 

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
		select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		t.column_name as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		1 as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id in(83,84) and s.group_id = t.group_id and s.id_sub_group = t.subgroup_id;


 INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select 
		 @row_number:=@row_number + 1 as id ,
		'CALCULATED' as `calculation_type`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.description as `display_description`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.subgroup_id as`subgroup_id`,
		s.id  as`config_id`,
        f.id as `function_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		1 as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		null as `currency`,
		'00' as `column_code`
		 from  column_configuration s,
				functions f,
(SELECT @row_number:=(SELECT max(id) from function_configuration)) AS t where s.group_id in (83,84); 

 


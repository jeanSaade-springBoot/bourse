INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	11 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'openeur'
        WHEN 2 THEN 'closeeur'
        WHEN 3 THEN 'high'
		WHEN 4 THEN 'low'
        WHEN 5 THEN 'volume'
        WHEN 6 THEN 'marketcap'
        WHEN 7 THEN 'openint'
		WHEN 8 THEN 'closeint'
    END AS column_name ,
	  CASE s.group_id 
          WHEN 71 THEN 'tmp_audit_cry_bitcoin'
          WHEN 72 THEN 'tmp_audit_cry_ethereum'
          WHEN 73 THEN 'tmp_audit_cry_solana' 
		  WHEN 74 THEN 'tmp_audit_cry_shiba'
          WHEN 75 THEN 'tmp_audit_cry_binance'
          WHEN 76 THEN 'tmp_audit_cry_xrp'  end as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(71,72,73,74,75,76) ;


INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
         CONCAT(t.column_name, '-', s.group_Id) as `description`,
		 s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		0 as `factor`,
		s.description  as `descwitoutfactor`,
		s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, 
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in (71,72,73,74,75,76)
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id;
	  


 INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select 
		 @row_number:=@row_number + 1 as id ,
		'CALCULATED' as `calculation_type`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.display_description as `display_description`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.subgroup_id as`subgroup_id`,
		s.id  as`config_id`,
        f.id as `function_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 s.factor as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		null as `currency`,
		s.column_code as `column_code`
		 from  column_configuration s,
				functions f,
(SELECT @row_number:=(SELECT max(id) from function_configuration)) AS t where s.group_id in (71,72,73,74,75,76)   ;


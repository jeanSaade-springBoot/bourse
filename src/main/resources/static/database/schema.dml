create table tmp_audit_sti_asia (id bigint not null, 
	 NIKKEI varchar(255), 
	 NIKKEI_USDJPY varchar(255),
	 CSI varchar(255),
	 CSI_USDCNY varchar(255),
	 NIFTY varchar(255), 
	 NIFTY_USDINR varchar(255), 
	 KOSPI varchar(255),
	 KOSPI_USDKRW varchar(255),
	 HANGSENG varchar(255),
	 HANGSENG_USDHKD varchar(255), 
     HISMBI varchar(255), 
     HISMBI_USDHKD varchar(255),    
     HISMPI varchar(255), 
     HISMPI_USDHKD varchar(255), 
 refer_date varchar(255), primary key (id));
 
create table audit_sti_asia_sequence (next_val bigint) ;
insert into audit_sti_asia_sequence values ( 1 );

 INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	7 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'NIKKEI'
        WHEN 2 THEN 'NIKKEI_USDJPY'
        WHEN 3 THEN 'CSI'
        WHEN 4 THEN 'CSI_USDCNY'
        WHEN 5 THEN 'NIFTY'
        WHEN 6 THEN 'NIFTY_USDINR'
        WHEN 7 THEN 'KOSPI'
        WHEN 8 THEN 'KOSPI_USDKRW'
        WHEN 9 THEN 'HANGSENG'
        WHEN 10 THEN 'HANGSENG_USDHKD'
		WHEN 11 THEN 'HISMBI'
		WHEN 12 THEN 'HISMBI_USDHKD'
		WHEN 13 THEN 'HISMPI'
        WHEN 14 THEN 'HISMPI_USDHKD'
    END AS column_name ,
	'tmp_audit_sti_asia' from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=32;
	 													
create table tmp_audit_sti_wall_street (id bigint not null, 

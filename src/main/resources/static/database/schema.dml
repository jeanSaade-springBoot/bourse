INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	9 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'FED'
        WHEN 2 THEN 'ECB'
        WHEN 3 THEN 'BOE'
    END AS column_name ,
	'tmp_audit_rts_central_banks' as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(48) ;


INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	9 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'EU'
        WHEN 2 THEN 'USA'
    END AS column_name ,
	'tmp_audit_rts_inflamation_swap_rates' as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(49) ;


INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	9 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'USA30'
    END AS column_name ,
	'tmp_audit_rts_mortgage_rates' as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(50) ;

 INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	9 as asset_id,
	s.group_id,
	s.id_sub_group,
	  CASE s.id_sub_group
          WHEN 1 THEN 'euribor_1'
        WHEN 2 THEN 'sonia_1'
        WHEN 3 THEN 'libor_1'
        WHEN 4 THEN 'euribor_3'
        WHEN 5 THEN 'sonia_3'
        WHEN 6 THEN 'libor_3'
    END AS column_name ,
	'tmp_audit_rts_fixings' as table_name 
          from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id in(51) ;
     

INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		CONCAT(t.column_name, '-', f.id,'.',s.group_Id) as `description`,
		 f.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		f.id as `factor`,
		f.description  as `descwitoutfactor`,
		f.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		f.id as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, factor_table f, factor_group_subgroup fg,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in(48,49)
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id
       and s.group_id=fg.group_id 	
       and f.id = fg.factor_id
       and  s.id_sub_group = fg.subgroup_id;
 
INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		t.column_name as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id in(50,51) and s.group_id = t.group_id and s.id_sub_group = t.subgroup_id;

	  

 INSERT INTO `bourse`.`function_configuration`
(`id`,
`calculation_type`,
`data_format`,
`description`,
`display_description`,
`group_id`,
`start_date`,
`subgroup_id`,
`config_id`,
`function_id`,
`tick_value`,
`chart_type`,
`y_axis_format`,
`factor`,
`descwitoutfactor`,
`column_name`,
`data_min_increment`,
`chart_color`,
`chart_showgrid`,
`chart_size`,
`chart_transparency`,
`chartshow_markes`,
`exchange_link`,
`show_in_database`,
`show_in_news_graph`,
`currency`,
`column_code`)
select 
		 @row_number:=@row_number + 1 as id ,
		'CALCULATED' as `calculation_type`,
		'0.000%' as `data_format`,
		s.description as `description`,
		s.display_description as `display_description`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.subgroup_id as`subgroup_id`,
		s.id  as`config_id`,
        f.id as `function_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 s.factor as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		null as `currency`,
		s.column_code as `column_code`
		 from  column_configuration s,
				functions f,
(SELECT @row_number:=(SELECT max(id) from function_configuration)) AS t where s.group_id in(48,49,50,51);
	  

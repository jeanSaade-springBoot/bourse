drop table tmp_audit_rts_central_banks;

create table tmp_audit_rts_central_banks (
  id bigint not null, 
  boe_monthly_base_rate varchar(255), 
  boe_refi_move varchar(255), 
  ecb_depo_move varchar(255), 
  ecb_depo_rate varchar(255), 
  ecb_lending_move varchar(255), 
  ecb_lending_rate varchar(255), 
  ecb_refi_move varchar(255), 
  ecb_refi_rate varchar(255), 
  fed_lower_move varchar(255), 
  fed_lower_rate varchar(255), 
  fed_upper_move varchar(255), 
  fed_upper_rate varchar(255), 
  refer_date varchar(255), 
  primary key (id)
);


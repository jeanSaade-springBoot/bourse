create table fx_usd_data_sequence (next_val bigint) ;
insert into fx_usd_data_sequence values ( 1 );

create table cds_data (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id)) ;
create table cds_data_sequence (next_val bigint) ;
insert into cds_data_sequence values ( 1 );


create table tmp_audit_bund_options_volume (id bigint not null, 
	 bund1 varchar(255), 
	 bund2 varchar(255),
	 bund1_bund2 varchar(255),
	 bund1_bund2_cp varchar(255),
 refer_date varchar(255), primary key (id));
 
create table audit_bund_options_volume_sequence (next_val bigint) ;
insert into audit_bund_options_volume_sequence values ( 1 );


create table tmp_audit_bobl_options_volume (id bigint not null, 
	 bobl1 varchar(255), 
	 bobl2 varchar(255),
	 bobl1_bobl2 varchar(255),
 refer_date varchar(255), primary key (id));
 
create table audit_bobl_options_volume_sequence (next_val bigint) ;
insert into audit_bobl_options_volume_sequence values ( 1 );

create table tmp_audit_buxl_options_volume (id bigint not null, 
	 buxl1 varchar(255), 
	 buxl2 varchar(255),
	 buxl1_buxl2 varchar(255),
 refer_date varchar(255), primary key (id));
 
create table audit_buxl_options_volume_sequence (next_val bigint) ;
insert into audit_buxl_options_volume_sequence values ( 1 );

create table tmp_audit_shatz_options_volume (id bigint not null, 
	 shatz1 varchar(255), 
	 shatz2 varchar(255),
	 shatz1_shatz2 varchar(255),
 refer_date varchar(255), primary key (id));
 
create table audit_shatz_options_volume_sequence (next_val bigint) ;
insert into audit_shatz_options_volume_sequence values ( 1 );

create table tmp_audit_euribor_options_volume (id bigint not null, 
	 euribor1 varchar(255), 
	 euribor2 varchar(255),
	 euribor3 varchar(255),
	 euribor4 varchar(255),
	 euribor5 varchar(255),
	 euribor1_euribor2_euribor3_euribor4_euribor5 varchar(255),
 refer_date varchar(255), primary key (id));
 
create table audit_euribor_options_volume_sequence (next_val bigint) ;
insert into audit_euribor_options_volume_sequence values ( 1 );

 INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	4,
	s.group_id,
	s.id_sub_group,
	CASE WHEN s.id_sub_group=1 THEN 'bund1' 
		 WHEN s.id_sub_group=2 THEN 'bund2'
		 WHEN s.id_sub_group=3 THEN 'bund1_bund2'
		ELSE 'bund1_bund2_cp' END ,
	'tmp_audit_bund_options_volume' from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=17;
	 
	 

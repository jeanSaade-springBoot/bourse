INSERT INTO `bourse`.`subgroup` (`id`, `description`, `group_id`, `id_sub_group`, `group_desc`, `subgroup_code`) 
SELECT   @rownum:=@rownum + 1 as id , S.description ,G.ID, S.id_sub_group,G.description,S.subgroup_code
from subgroup S, 
groups_table G,
(SELECT @rownum := 458) r
 WHERE S.group_id=61 AND G.ASSET_ID=10 AND G.ID IN(62,63,64,65,66,67,68,69,70);
 

 create table long_ends_display_settings (
	 id bigint not null, 
	 group_id bigint not null, 
	 subgroup_id bigint not null, 
     parentgroup_id bigint not null, 
	 is_visible boolean, primary key (id));
create table long_ends_display_settings_sequence (next_val bigint) ;
insert into long_ends_display_settings_sequence values ( 1 );

insert into long_ends_display_settings (id,group_id,subgroup_id,is_visible,parentgroup_id)
select @rownum:=@rownum + 1 as id, 
		g.id ,
		s.id_sub_group,
		true ,
		null
	from
		groups_table g,
		subgroup s,
		(SELECT @rownum := 0) r
		 where asset_id=10 and g.id=s.group_id;

update long_ends_display_settings set parentgroup_id=52 where group_id in (53,54,55);

update long_ends_display_settings set parentgroup_id=56 where group_id in (57);

update long_ends_display_settings set parentgroup_id=59 where group_id in (60);


alter table tmp_audit_precious add column `open_gold` varchar(255);
alter table tmp_audit_precious add column `high_gold` varchar(255);
alter table tmp_audit_precious add column `low_gold` varchar(255);
alter table tmp_audit_precious add column `open_silver` varchar(255);
alter table tmp_audit_precious add column `high_silver` varchar(255);
alter table tmp_audit_precious add column `low_silver` varchar(255);

ALTER TABLE `bourse`.`tmp_audit_precious` 
CHANGE COLUMN `GOLD` `close_gold` VARCHAR(255) CHARACTER SET 'utf8mb4' NULL DEFAULT NULL ,
CHANGE COLUMN `SILVER` `close_silver` VARCHAR(255) CHARACTER SET 'utf8mb4' NULL DEFAULT NULL ;


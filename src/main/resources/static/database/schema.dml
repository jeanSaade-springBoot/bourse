 INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
1,
s.group_id,
s.id_sub_group,
CASE WHEN s.id_sub_group=1 THEN 'usatoaaa' 
	 WHEN s.id_sub_group=2 THEN 'usbtobbb'
	 WHEN s.id_sub_group=3 THEN 'usctoccc'
	 WHEN s.id_sub_group=4 THEN 'eurozoneatoaaa'
	ELSE 'eurozonebtobbb' END ,
'tmp_audit_corporate_yields' from subgroup s,
 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=11;
 
 INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
1,
s.group_id,
s.id_sub_group,
CASE WHEN s.id_sub_group=1 THEN 'usatoaaa_usa' 
	 WHEN s.id_sub_group=2 THEN 'usbtobbb_usatoaaa'
	 WHEN s.id_sub_group=3 THEN 'usctoccc_usbtobbb'
	 WHEN s.id_sub_group=4 THEN 'eurozoneatoaaa_germany'
	ELSE 'eurozonebtobbb_eurozoneatoaaa' END ,
'tmp_audit_credit_spreads' from subgroup s,
 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=12;
 
 INSERT INTO `bourse`.`table_management`
(`id`,
`asset_id`,
`group_id`,
`subgroup_id`,
`column_name`,
`table_name`)
select
@rownum:=@rownum + 1  as id ,
3,
s.group_id,
s.id_sub_group,
CASE WHEN s.id_sub_group=1 THEN 'avg_usatoaaa_usa' 
	 WHEN s.id_sub_group=2 THEN 'avg_usbtobbb_usatoaaa'
	 WHEN s.id_sub_group=3 THEN 'avg_usctoccc_usbtobbb'
	 WHEN s.id_sub_group=4 THEN 'avg_eurozoneatoaaa_germany'
	ELSE 'avg_eurozonebtobbb_eurozoneatoaaa' END ,
'tmp_audit_corporate_liquidity_premia' from subgroup s,
 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=13;
 
INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
		select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		t.column_name as `description`,
		s.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 s.description as `descwitoutfactor`,
		 s.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		1 as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t where s.group_id in(11,12,13) and s.group_id = t.group_id and s.id_sub_group = t.subgroup_id;


     `marketcap` varchar(255), 
     `openint` varchar(255), 
     `closeint` varchar(255), 
 refer_date varchar(255), primary key (id));
create table audit_cry_bitcoin_sequence (next_val bigint) ;
insert into audit_cry_bitcoin_sequence values ( 1 );


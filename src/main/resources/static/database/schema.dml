 CREATE TABLE `tmp_precious_trend_following_gold` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `refer_date` date NOT NULL,
  `mav5` decimal(18,8) DEFAULT NULL,
  `mav6` decimal(18,8) DEFAULT NULL,
  `mav7` decimal(18,8) DEFAULT NULL,
  `mav9` decimal(18,8) DEFAULT NULL,
  `mav18` decimal(18,8) DEFAULT NULL,
  `mav21` decimal(18,8) DEFAULT NULL,
  `mav25` decimal(18,8) DEFAULT NULL,
  `mav30` decimal(18,8) DEFAULT NULL,
  `mav45` decimal(18,8) DEFAULT NULL,
  `mav63` decimal(18,8) DEFAULT NULL,
  `mav5_mav6` decimal(18,8) DEFAULT NULL,
  `mav5_mav7` decimal(18,8) DEFAULT NULL,
  `mav5_mav9` decimal(18,8) DEFAULT NULL,
  `mav18_mav21` decimal(18,8) DEFAULT NULL,
  `mav18_mav25` decimal(18,8) DEFAULT NULL,
  `mav18_mav30` decimal(18,8) DEFAULT NULL,
  `mav45_mav63` decimal(18,8) DEFAULT NULL,
  `last_updated` timestamp NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `refer_date` (`refer_date`)
);

CREATE TABLE tmp_precious_trend_following_silver LIKE tmp_precious_trend_following_gold;
 
CREATE TABLE tmp_precious_realized_vol_span_gold (
    refer_date DATE PRIMARY KEY,

    daily_true_range DECIMAL(18,8),

    rv_5d  DECIMAL(18,8),
    rv_10d DECIMAL(18,8),
    rv_15d DECIMAL(18,8),
    rv_22d DECIMAL(18,8),
    rv_50d DECIMAL(18,8),

    span_5d  DECIMAL(18,8),
    span_10d DECIMAL(18,8),
    span_15d DECIMAL(18,8),
    span_22d DECIMAL(18,8),
    span_50d DECIMAL(18,8),

    INDEX idx_refer_date (refer_date)
);
CREATE TABLE tmp_precious_realized_vol_span_silver LIKE tmp_precious_realized_vol_span_gold;



CREATE TABLE tmp_precious_weighted_trend_gold (
    refer_date DATE NOT NULL,
    obb_5d   DECIMAL(18,8),
    obb_9d   DECIMAL(18,8),
    obb_18d  DECIMAL(18,8),
    obb_30d  DECIMAL(18,8),
    obs_5d   DECIMAL(18,8),
    obs_9d   DECIMAL(18,8),
    obs_18d  DECIMAL(18,8),
    obs_30d  DECIMAL(18,8),
    eb_9d    DECIMAL(18,8),
    eb_21d   DECIMAL(18,8),
    eb_9s    DECIMAL(18,8),
    eb_21s   DECIMAL(18,8),
    bol_p_10d DECIMAL(18,8),
    bol_p_20d DECIMAL(18,8),
    bol_m_10d DECIMAL(18,8),
    bol_m_20d DECIMAL(18,8),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (refer_date)
);

CREATE TABLE tmp_precious_weighted_trend_silver LIKE tmp_precious_weighted_trend_gold;



create table foodstuff_data (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id)) ;
create table foodstuff_data_sequence (next_val bigint) ;
insert into foodstuff_data_sequence values ( 1 );
create table tmp_audit_foodstuff (id bigint not null, corn varchar(255), sugar varchar(255), wheat varchar(255), refer_date varchar(255), primary key (id));

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		description,
		'dyncamic_robots_highlow_mono' as robot_name,
		'PROCESS_WITHOUT_FUNCTION' as process_name,
		2 as asset_id,
		8 as group_id,
        null as function_id
 from column_configuration,   
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
 where  group_id =8;
 
update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

   

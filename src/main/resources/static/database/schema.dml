`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		description,
		'dyncamic_robots_function_trend_mono' as robot_name,
		'PROCESS_WITH_FUNCTION' as process_name,
		7 as asset_id,
		35 as group_id,
        6 as function_id
 from column_configuration,   
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
 where group_id in(35);
 
 update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);
 

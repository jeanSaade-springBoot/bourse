create table cryptos_data (
  id bigint not null, 
  refer_date varchar(255), 
  group_id bigint, 
  subgroup_id bigint, 
  value varchar(255), 
  primary key (id)
);

create table cryptos_data_sequence (next_val bigint) ;
insert into cryptos_data_sequence values ( 1 );


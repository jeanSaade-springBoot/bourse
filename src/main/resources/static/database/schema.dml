delete from table_management  where group_id=32;
 INSERT INTO `bourse`.`table_management`
	(`id`,
	`asset_id`,
	`group_id`,
	`subgroup_id`,
	`column_name`,
	`table_name`)
	select
	@rownum:=@rownum + 1  as id ,
	7 as asset_id,
	s.group_id,
	s.id_sub_group,
	 CASE s.id_sub_group
        WHEN 1 THEN 'NIKKEI'
        WHEN 8 THEN 'NIKKEI_USDJPY'
        WHEN 2 THEN 'CSI'
        WHEN 9 THEN 'CSI_USDCNY'
        WHEN 3 THEN 'NIFTY'
        WHEN 10 THEN 'NIFTY_USDINR'
        WHEN 4 THEN 'KOSPI'
        WHEN 11 THEN 'KOSPI_USDKRW'
        WHEN 5 THEN 'HANGSENG'
        WHEN 12 THEN 'HANGSENG_USDHKD'
		WHEN 6 THEN 'HISMBI'
		WHEN 13 THEN 'HISMBI_USDHKD'
		WHEN 7 THEN 'HISMPI'
        WHEN 14 THEN 'HISMPI_USDHKD'
    END AS column_name ,
	'tmp_audit_sti_asia' from subgroup s,
	 (SELECT @rownum:=(select max(id) from table_management)) r where s.group_id=32;



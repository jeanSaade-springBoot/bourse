update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
SELECT @rownum := @rownum + 1 AS id, 
       c.description, 
       'dyncamic_robots_highlow_mono' AS robot_name, 
       'PROCESS_WITHOUT_FUNCTION' AS process_name, 
       10 AS asset_id, 
       c.group_id, 
       null as function_id
FROM column_configuration c,
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
WHERE group_id IN (52,53,54,55,56,57,58,59,60) and c.subgroup_id in(2,3,4,5,6);

update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);


CREATE TABLE tmp_lef_realized_vol_span_bund (
    refer_date DATE PRIMARY KEY,

    daily_true_range DECIMAL(18,8),

    rv_5d  DECIMAL(18,8),
    rv_10d DECIMAL(18,8),
    rv_15d DECIMAL(18,8),
    rv_22d DECIMAL(18,8),
    rv_50d DECIMAL(18,8),

    span_5d  DECIMAL(18,8),
    span_10d DECIMAL(18,8),
    span_15d DECIMAL(18,8),
    span_22d DECIMAL(18,8),
    span_50d DECIMAL(18,8),

    INDEX idx_refer_date (refer_date)
);
CREATE TABLE tmp_lef_realized_vol_span_bobl LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_shatz LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_buxl LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_oat LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_btp LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_gilt LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_ty LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_lef_realized_vol_span_us LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_btc LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_eth LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_sol LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_shib LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_bnb LIKE tmp_lef_realized_vol_span_bund;
CREATE TABLE tmp_cry_realized_vol_span_xrp LIKE tmp_lef_realized_vol_span_bund;



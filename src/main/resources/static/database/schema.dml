INSERT INTO `bourse`.`factor_group_subgroup` (`factor_id`, `group_id`, `subgroup_id`) VALUES ('12', '30', '1'), ('12', '30', '2'), ('12', '30', '3'), ('12', '30', '4'), ('12', '30', '5'), ('12', '30', '6'), ('12', '30', '7'), ('12', '30', '8'), ('12', '30', '9'), ('12', '30', '10'), ('12', '30', '11'),('12', '31', '1'), ('12', '31', '2'), ('12', '31', '3'), ('12', '31', '4'), ('12', '31', '5'), ('12', '31', '6'), ('12', '31', '7'), ('12', '31', '8'), ('12', '31', '9'), ('12', '31', '10'), ('12', '31', '11');



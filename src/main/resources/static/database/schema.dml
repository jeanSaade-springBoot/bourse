alter table robots_configuration add column db_robot_name varchar(255);
alter table robots_function_configuration add column db_robot_name varchar(255);



update robots_configuration set db_robot_name='dyncamic_robots_highlow_mono' where robot_name='HighLowRobot';
update robots_configuration set db_robot_name='dyncamic_robots_jump_mono' where robot_name='JumpRobot';
update robots_configuration set db_robot_name='dyncamic_robots_trend_mono' where robot_name='TrendRobot';
update robots_configuration set db_robot_name='dynamic_robots_scaled_jump_mono' where robot_name='ScaledJumpRobot';


update robots_function_configuration set db_robot_name='dyncamic_robots_function_highlow_mono' where robot_name='HighLowRobot';
update robots_function_configuration set db_robot_name='dyncamic_robots_function_jump_mono' where robot_name='JumpRobot';
update robots_function_configuration set db_robot_name='dyncamic_robots_function_trend_mono' where robot_name='TrendRobot';

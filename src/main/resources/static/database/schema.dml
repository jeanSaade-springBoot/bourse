 alter table robots_configuration add column jump_scaled_value varchar(255);
alter table robots_function_configuration add column jump_scaled_value varchar(255);


update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		c.description,
		'dynamic_robots_scaled_jump_mono' as robot_name,
		'PROCESS_WITHOUT_FUNCTION' as process_name,
		g.asset_id,
		c.group_id,
        null as function_id
 from column_configuration c,  groups_table g ,
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r  where c.group_id=g.id;
 
  update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		c.description,
		'`dynamic_robots_function_scaled_jump_mono`' as robot_name,
		'PROCESS_WITH_FUNCTION' as process_name,
		g.asset_id,
		c.group_id,
        c.function_id as function_id
 from function_configuration c,  groups_table g ,
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r  where c.group_id=g.id;
 
 update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);



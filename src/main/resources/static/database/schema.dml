create table energy_data (id bigint not null, refer_date varchar(255), subgroup_id bigint, value varchar(255), primary key (id)) ;

create table energy_data_sequence (next_val bigint) ;
insert into energy_data_sequence values ( 1 );

create table tmp_audit_energy (id bigint not null, 
OIL varchar(255), 
`GASOLINE_GALL` varchar(255), 
`DIESEL_GALL` varchar(255),
`NATGAS_USD` varchar(255), 
`NATGAS_EUR` varchar(255),
`GASOLINE_LITRE` varchar(255), 
`DIESEL_TON` varchar(255),
 refer_date varchar(255), primary key (id));
 

update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		description,
		'dyncamic_robots_highlow_mono' as robot_name,
		'PROCESS_WITHOUT_FUNCTION' as process_name,
		2 as asset_id,
		9 as group_id,
        null as function_id
 from column_configuration,   
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
 where  group_id =9;
 
update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

   

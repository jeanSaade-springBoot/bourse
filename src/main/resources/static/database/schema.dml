CREATE TABLE tmp_lef_weighted_trend_rolling_bund (
    refer_date DATE NOT NULL,
    obb_5d   DECIMAL(18,8),
    obb_9d   DECIMAL(18,8),
    obb_18d  DECIMAL(18,8),
    obb_30d  DECIMAL(18,8),
    obs_5d   DECIMAL(18,8),
    obs_9d   DECIMAL(18,8),
    obs_18d  DECIMAL(18,8),
    obs_30d  DECIMAL(18,8),
    eb_9d    DECIMAL(18,8),
    eb_21d   DECIMAL(18,8),
    eb_9s    DECIMAL(18,8),
    eb_21s   DECIMAL(18,8),
    bol_p_10d DECIMAL(18,8),
    bol_p_20d DECIMAL(18,8),
    bol_m_10d DECIMAL(18,8),
    bol_m_20d DECIMAL(18,8),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (refer_date)
);


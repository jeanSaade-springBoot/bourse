update factor_group_subgroup set factor_id=13 where factor_id=11 and group_id=31;

delete from column_configuration where group_id in(30,31) ;
  
INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		CONCAT(t.column_name, '-', f.id) as `description`,
		 f.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		 0 as `factor`,
		 f.description  as `descwitoutfactor`,
		f.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		'00' as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, factor_table f, factor_group_subgroup fg,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in(30,31) 
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id
       and s.group_id=fg.group_id 	
       and f.id = fg.factor_id
       and  s.id_sub_group = fg.subgroup_id;
	   

UPDATE `bourse`.`groups_table` SET `group_code` = 'BUX' WHERE (`id` = '29');

delete from column_configuration where group_id in(25,26,27,28,29,30,31) ;
 
INSERT INTO `bourse`.`column_configuration`
		(`id`,
		`calculation_type`,
		`can_be_negative`,
		`currency`,
		`data_format`,
		`description`,
		`display_description`,
		`graph_scale`,
		`group_id`,
		`start_date`,
		`subgroup_id`,
		`tick_value`,
		`chart_type`,
		`y_axis_format`,
		`factor`,
		`descwitoutfactor`,
		`column_name`,
		`data_min_increment`,
		`chart_color`,
		`chart_showgrid`,
		`chart_size`,
		`chart_transparency`,
		`chartshow_markes`,
		`exchange_link`,
		`show_in_database`,
		`show_in_news_graph`,
		`column_code`,
		`status`)
select 
		 @row_number:=@row_number + 1 as id ,
		'INPUT' as `calculation_type`,
		 false as `can_be_negative`,
		 null as `currency`,
		'0.000%' as `data_format`,
		CONCAT(t.column_name, '-', f.id,'.',s.group_Id) as `description`,
		 f.description as `display_description`,
		null as `graph_scale`,
		s.group_Id as `group_id`,
		'03-01-2000' as `start_date`,
		s.id_sub_group as`subgroup_id`,
		null as `tick_value`,
		'Area' as `chart_type`,
		'0.00%' as `y_axis_format`,
		f.id as `factor`,
		f.description  as `descwitoutfactor`,
		f.description as `column_name`,
		null as `data_min_increment`,
		'#44546a' as `chart_color`,
		'true' as `chart_showgrid`,
		'12px' as `chart_size`,
		1 as `chart_transparency`,
		1 as `chartshow_markes`,
		null as `exchange_link`,
		false as `show_in_database`,
		false as `show_in_news_graph`,
		f.id as `column_code`,
		'Ti3lZXf6Pk2NuA3KpLTEUv4voVgsqAR2' as `status`
		 from  subgroup s, table_management t, factor_table f, factor_group_subgroup fg,
(SELECT @row_number:=(SELECT max(id) from column_configuration)) AS t 
where 
	 s.group_id in(25,26,27,28,29,30,31) 
      and s.group_id = t.group_id 
	   and s.id_sub_group = t.subgroup_id
       and s.group_id=fg.group_id 	
       and f.id = fg.factor_id
       and  s.id_sub_group = fg.subgroup_id;
	   
delete from robot_initializer where asset_id=6;

update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);

 INSERT INTO `bourse`.`robot_initializer`
(`id`,
`column_name`,
`robot_name`,
`process_name`,
`asset_id`,
`group_id`,
`FUNCTION_ID`)
select @rownum:=@rownum + 1  as id ,
		description,
		'dyncamic_robots_highlow_mono' as robot_name,
		'PROCESS_WITHOUT_FUNCTION' as process_name,
		6 as asset_id,
		25 as group_id,
        null as function_id
 from column_configuration,   
 (SELECT @rownum:=(select next_val from robot_initializer_sequence)) r
 where  group_id in(25);
 
update robot_initializer_sequence set next_val =(select max(id)  from robot_initializer);



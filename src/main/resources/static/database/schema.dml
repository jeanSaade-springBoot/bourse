	`user_name` varchar(255) NOT NULL,
     `graph_id` varchar(255) NOT NULL,
     start_date varchar(255) NOT NULL,
     start_price varchar(255) NOT NULL,
     end_date varchar(255) NOT NULL,
     end_price varchar(255) NOT NULL,
     percentage10 varchar(255) NOT NULL,
     percentage25 varchar(255) NOT NULL,
     percentage33 varchar(255) NOT NULL,
     percenetage38 varchar(255) NOT NULL,
     percentage50 varchar(255) NOT NULL,
     percentage62 varchar(255) NOT NULL,
     percentage66 varchar(255) NOT NULL,
     percentage75 varchar(255) NOT NULL,
     hide_percentage10  tinyint(1) DEFAULT '0',
     hide_percentage25  tinyint(1) DEFAULT '0',
     hide_percentage33  tinyint(1) DEFAULT '0',
     hide_percenetage38 tinyint(1) DEFAULT '0',
     hide_percentage50  tinyint(1) DEFAULT '0',
     hide_percentage62  tinyint(1) DEFAULT '0',
     hide_percentage66  tinyint(1) DEFAULT '0',
     hide_percentage75  tinyint(1) DEFAULT '0'
    );
